# Copie este arquivo para .env e preencha os valores reais fora do Git.
DB_URL=jdbc:mysql://localhost:3306/taotenshin
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha
# Gere uma chave Base64 com pelo menos 32 bytes: openssl rand -base64 32
JWT_SECRET=sua_chave_base64_de_32_bytes_ou_mais
JWT_VALIDITY=3600
